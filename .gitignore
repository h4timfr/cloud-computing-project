.env
.env.*
.floodpulse-key
# the ingest key is generated into a sibling temp file before it is renamed into place, and
# any future rotation writes .floodpulse-key.<something>: neither may ever be committed
.floodpulse-key*
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.pem
*.key
*.p12
*.log
# scratch and editor leftovers: a deploy zip or a stale backup sitting in the tree is how a
# deployment ends up shipping a file nobody reviewed
*.zip
*.tmp
*.bak
*.orig
*.rej
nul
Thumbs.db
.DS_Store
